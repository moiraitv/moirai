{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "overrides": [
    {
      "files": ["README.md", "SECURITY.md", "apps/docs/src/**/*.md"],
      "options": {
        "proseWrap": "never"
      }
    },
    {
      "files": "*.{css,scss}",
      "options": {
        "useTabs": true
      }
    }
  ]
}
