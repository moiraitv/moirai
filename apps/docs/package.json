{
  "name": "@moirai/docs",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ../../scripts/user-docs.ts manifest && vitepress dev",
		"build": "node --import tsx ../../scripts/user-docs.ts manifest && vitepress build && node --import tsx ../../scripts/user-docs.ts bundle",
    "typecheck": "node --import tsx ../../scripts/user-docs.ts manifest && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
