MOIRAI_HOST=127.0.0.1
MOIRAI_PORT=3000
MOIRAI_PUBLIC_URL=http://127.0.0.1:3000
# Development web server configuration.
# Browser-facing Vite origin when it differs from the API origin.
# MOIRAI_MANAGEMENT_URL=http://127.0.0.1:5173
# Vite server port.
# MOIRAI_WEB_PORT=5173
# Optional Vite bind override; non-loopback hosts bind all interfaces by default.
# MOIRAI_WEB_HOST=0.0.0.0
# Comma-separated proxy IPs/CIDRs trusted to supply the original client address.
# MOIRAI_TRUST_PROXY=127.0.0.1
# Optional Logto traditional-web application. Set all three values together.
# MOIRAI_LOGTO_ENDPOINT=https://your-tenant.logto.app
# MOIRAI_LOGTO_APP_ID=your-app-id
# MOIRAI_LOGTO_APP_SECRET=your-app-secret
# Published guide horizon, 1–14 local days; one extra day is generated internally.
MOIRAI_GUIDE_DAYS=7
MOIRAI_PLAYOUT_SYNC_INTERVAL_SECONDS=60
MOIRAI_PLAYBACK_STREAM_DIR=streams
MOIRAI_PLAYBACK_PLAYOUT_DIR=playout
MOIRAI_PLAYBACK_READY_TIMEOUT_MS=30000
MOIRAI_PLAYBACK_STOP_GRACE_MS=5000
# Show engine fallback errors to viewers (may include paths and FFmpeg details).
# Requires restarting Moirai; independent of the log level.
MOIRAI_DEBUG=false
MOIRAI_LOG_LEVEL=info
MOIRAI_LOG_DIR=./data/logs
MOIRAI_LOG_RETENTION_DAYS=14
MOIRAI_LOG_MAX_MB=200
MOIRAI_LOG_FILE_MAX_MB=10
MOIRAI_TIME_ZONE=
MOIRAI_DATA_DIR=./data
MOIRAI_ARTWORK_CACHE_MAX_MB=2048
MOIRAI_ARTWORK_CACHE_MAX_ENTRY_MB=25
MOIRAI_ARTWORK_TRANSFORM_CONCURRENCY=4
MOIRAI_FFPROBE_PATH=ffprobe
MOIRAI_MEDIA_PROBE_CONCURRENCY=2
MOIRAI_MEDIA_PROBE_TIMEOUT_MS=15000
MOIRAI_SCHEDULING_WORKERS=2
MOIRAI_SCHEDULING_WORKER_QUEUE=32
MOIRAI_MAX_EXPLICIT_MEDIA_ITEMS=500
MOIRAI_SCAN_CANCEL_GRACE_MS=5000
MOIRAI_SHUTDOWN_DEADLINE_MS=10000
MOIRAI_SCAN_HISTORY_RETENTION_DAYS=30
MOIRAI_SCAN_HISTORY_MAX_PER_LIBRARY=2000
# Optional explicit standalone engine. Development otherwise checks ETV_NEXT_DIR,
# the pinned vendor/ersatztv-next submodule, and PATH in that order.
# MOIRAI_ETV_CHANNEL_PATH=/absolute/path/to/ersatztv-channel
# ETV_NEXT_DIR=/absolute/path/to/an/alternate/next/checkout
