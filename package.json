{
  "name": "moirai",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run build -w @moirai/shared && npm run build -w @moirai/ersatztv-contract && npm run build -w @moirai/server && npm run build -w @moirai/web && npm run build -w @moirai/docs",
    "build:production": "npm run security:audit && npm run docs:user:review:check && npm run build",
    "build:docker": "node scripts/build-docker.mjs",
    "security:audit": "npm exec --include=dev --include=optional -- better-npm-audit audit --level low --require-notes --require-expiry",
    "start": "npm run start -w @moirai/server",
    "auth:reset": "node --env-file-if-exists=.env apps/server/dist/auth-reset.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config playwright.docs.config.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json --noEmit",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "eslint . && prettier --check .",
    "docs:api": "tsx scripts/api-docs.ts",
    "docs:api:check": "tsx scripts/api-docs.ts --check",
    "docs:user:manifest": "tsx scripts/user-docs.ts manifest",
    "docs:user:dev": "npm run dev -w @moirai/docs",
    "docs:user:build": "npm run build -w @moirai/docs",
    "docs:user:check": "tsx scripts/user-docs.ts check",
    "docs:user:review:list": "tsx scripts/user-docs.ts list",
    "docs:user:review:migrate": "tsx scripts/user-docs.ts migrate",
    "docs:user:review:approve": "tsx scripts/user-docs.ts approve",
    "docs:user:review:check": "node --import tsx scripts/user-docs.ts review-check",
    "docs:user:screenshots:update": "playwright test --config playwright.docs.config.ts --grep @docs-screenshot && tsx tests/e2e/documentation/publish.ts",
    "ai:compare": "node --env-file-if-exists=.env --import tsx scripts/compare-ai-models.ts",
    "ai:compare:html": "node --env-file-if-exists=.env --import tsx scripts/ai-production-comparison.ts",
    "etv:setup": "node scripts/etv-development.mjs setup",
    "etv:build": "node scripts/etv-development.mjs build",
    "etv:check": "tsx scripts/etv-contract.ts check",
    "etv:sync": "tsx scripts/etv-contract.ts sync",
    "embeddings:model": "node scripts/embedding-model.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@asyncapi/parser": "^3.6.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@scalar/fastify-api-reference": "^1.78.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "better-npm-audit": "^4.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.6",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "pinia": "^4.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "vitepress@1.6.4": {
      "vite": "7.3.8",
      "@vitejs/plugin-vue": "6.0.11"
    },
    "@huggingface/transformers@3.8.1": {
      "sharp": "0.35.5"
    },
    "onnxruntime-node@1.21.0": {
      "global-agent": "4.1.3"
    },
    "argparse@1.0.10": "2.0.1"
  }
}
